  "dependencies": {
    "@aichess/core": "workspace:*",
    "@aichess/db": "workspace:*",
    "@aichess/runtime": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.2.0",
    "bullmq": "^6.3.0",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.12.0",
    "ioredis": "^5.6.0",
    "pino": "^10.3.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@agenticchess/sdk": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
