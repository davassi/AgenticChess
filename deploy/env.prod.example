# Template for the production .env. deploy/init-env.sh writes the real file on
# the instance with generated secrets; it is never committed.

# --- secrets, generated with openssl rand ---
POSTGRES_PASSWORD=
INTERNAL_API_TOKEN=
AUTH_SECRET=

# --- datastores: service names on the compose network, never host ports ---
POSTGRES_USER=aichess
POSTGRES_DB=aichess
DATABASE_URL=postgres://aichess:${POSTGRES_PASSWORD}@postgres:5432/aichess
REDIS_URL=redis://redis:6379

# --- game rules ---
DEFAULT_TIME_PER_MOVE_MS=60000
MOVE_LIMIT_PLIES=300
ILLEGAL_ATTEMPTS_PER_TURN=3
LOG_LEVEL=info

# --- api ---
API_PORT=3001
API_HOST=0.0.0.0
WEB_ORIGIN=https://agenticchess.online
RATE_LIMIT_AGENT_PER_MINUTE=120
RATE_LIMIT_PUBLIC_PER_MINUTE=300
SSE_PING_INTERVAL_MS=15000
PRESENCE_TTL_SECONDS=30

# Required behind Caddy. Left false, Fastify sees the proxy's address for every
# request, so the per-client rate limits become one shared global limit and a
# single busy agent starves everyone else.
TRUST_PROXY=true

# --- worker ---
RECONCILE_INTERVAL_MS=10000
RECONCILE_STALE_TURN_MS=10000
DEADLINE_CONCURRENCY=10
WORKER_HEALTH_PORT=3002
WORKER_HEALTH_HOST=0.0.0.0
MATCHMAKING_INTERVAL_MS=3000
MATCHMAKING_OFFLINE_GRACE_MS=15000

# --- web ---
# The address the browser uses; server components hand it to client components.
API_PUBLIC_URL=https://api.agenticchess.online
# Where the web app reaches the API from inside the compose network, avoiding a
# round trip out through the proxy and back.
API_INTERNAL_URL=http://api:3001

# Auth.js derives its own address from request headers unless told, and behind
# this proxy it derives https://localhost:3000, which GitHub then rejects as a
# redirect_uri mismatch. Say it outright instead.
AUTH_URL=https://agenticchess.online

# From a GitHub OAuth App. Its callback must be exactly
# https://agenticchess.online/api/auth/callback/github, and only the account
# that owns the app can create it, so these two stay blank until pasted in.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Comma-separated addresses promoted to admin at their next sign-in.
ADMIN_EMAILS=

# --- sparring ---
# The house agent: it waits in the unrated queue so a newcomer always has an
# opponent. Turning it off leaves that queue empty; nothing else changes.
SPARRING_ENABLED=true
# The key the service authenticates with, in the arena's own ac_ form.
# init-env.sh generates one; ensure-sparring hashes it into the agent row on
# every deploy, so rotating it here is enough to rotate it everywhere.
SPARRING_API_KEY=
SPARRING_BASE_URL=http://api:3001
OLLAMA_URL=http://ollama:11434
SPARRING_MODEL=gemma3:270m
SPARRING_TIMEOUT_MS=15000
SPARRING_FALLBACK=greedy
SPARRING_HEALTH_PORT=3003
# How often the bot re-asserts its place in the practice queue. The arena drops
# a queued agent seconds after its stream closes, so this bounds how long the
# queue can be empty after an api restart.
SPARRING_PRESENCE_SWEEP_MS=60000
# The identity ensure-sparring creates and the bot signs in as. Change these
# only together with the row in the database.
SPARRING_SLUG=sparring
SPARRING_NAME=Sparring Partner
SPARRING_OWNER_EMAIL=house@agenticchess.online
SPARRING_MODEL_PROVIDER=ollama
# Pin to replay a bot's fallback moves; otherwise a fresh stream every start.
# SPARRING_SEED=
SPARRING_HEALTH_HOST=0.0.0.0
