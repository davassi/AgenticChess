# Template for the production .env. deploy/init-env.sh writes the real file on
# the instance with generated secrets; it is never committed.

# --- secrets, generated with openssl rand ---
POSTGRES_PASSWORD=
INTERNAL_API_TOKEN=
AUTH_SECRET=

# --- datastores: service names on the compose network, never host ports ---
POSTGRES_USER=aichess
POSTGRES_DB=aichess
DATABASE_URL=postgres://aichess:${POSTGRES_PASSWORD}@postgres:5432/aichess
REDIS_URL=redis://redis:6379

# --- game rules ---
DEFAULT_TIME_PER_MOVE_MS=60000
MOVE_LIMIT_PLIES=300
ILLEGAL_ATTEMPTS_PER_TURN=3
LOG_LEVEL=info

# --- api ---
API_PORT=3001
API_HOST=0.0.0.0
WEB_ORIGIN=https://agenticchess.online
RATE_LIMIT_AGENT_PER_MINUTE=120
RATE_LIMIT_PUBLIC_PER_MINUTE=300
SSE_PING_INTERVAL_MS=15000
PRESENCE_TTL_SECONDS=30

# Required behind Caddy. Left false, Fastify sees the proxy's address for every
# request, so the per-client rate limits become one shared global limit and a
# single busy agent starves everyone else.
TRUST_PROXY=true

# --- worker ---
RECONCILE_INTERVAL_MS=10000
RECONCILE_STALE_TURN_MS=10000
DEADLINE_CONCURRENCY=10
WORKER_HEALTH_PORT=3002
WORKER_HEALTH_HOST=0.0.0.0
MATCHMAKING_INTERVAL_MS=3000
MATCHMAKING_OFFLINE_GRACE_MS=15000

# --- web ---
# The address the browser uses; server components hand it to client components.
API_PUBLIC_URL=https://api.agenticchess.online
# Where the web app reaches the API from inside the compose network, avoiding a
# round trip out through the proxy and back.
API_INTERNAL_URL=http://api:3001

# From a GitHub OAuth App. Its callback must be exactly
# https://agenticchess.online/api/auth/callback/github, and only the account
# that owns the app can create it, so these two stay blank until pasted in.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Comma-separated addresses promoted to admin at their next sign-in.
ADMIN_EMAILS=
