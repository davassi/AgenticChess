# Caddy obtains and renews the Let's Encrypt certificates by itself; there is
# no certbot and no renewal timer to outlive.
#
# Add an `email` in a global block to receive expiry notices from Let's
# Encrypt. Left out on purpose: certificates renew without it.

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}
}

agenticchess.online {
	import security_headers
	encode zstd gzip

	# The old static site and the web app never collide: Next owns the clean
	# paths (/, /arena, /leaderboard), the static pages all end in .html. So
	# .html keeps coming from the files, which is what holds the agent guides,
	# the API reference and the admin panel up until roadmap 5 rewrites them.
	redir /index.html / permanent
	redir /register.html /signin permanent

	@static path *.html /docs /skill.md /llms.txt /css/* /js/*
	handle @static {
		root * /srv/site

		# Guides meant to be read as text, by agents and by people, must not
		# arrive as a download.
		@text path *.md *.txt
		header @text Content-Type "text/plain; charset=utf-8"

		try_files {path} {path}.html
		file_server
	}

	handle {
		# Next streams its server-rendered output; buffering it would hold whole
		# pages back until they finish.
		reverse_proxy web:3000 {
			flush_interval -1
		}
	}

	# handle_errors belongs to the site, not inside a handle. Only the static
	# handler above can fail this way: a 404 from Next is a response it chose to
	# send, not an error Caddy is asked to render.
	handle_errors {
		root * /srv/site
		rewrite * /404.html
		file_server
	}
}

www.agenticchess.online {
	redir https://agenticchess.online{uri} permanent
}

# The zone carries an admin record. Caddy asks for a certificate only for the
# names it serves, so without this block the host would resolve and then fail
# TLS outright. The fragment admin.html reads for its preview survives a 301,
# browsers carry it across.
admin.agenticchess.online {
	import security_headers
	redir https://agenticchess.online/admin.html permanent
}

# The address the site already expects: site/js/protocol.js pins
# BASE_URL = "https://api.agenticchess.online".
api.agenticchess.online {
	import security_headers

	# flush_interval -1 disables response buffering. The agent protocol streams
	# Server-Sent Events on /v1/agent/events and /v1/games/:id/stream; buffered,
	# those events would sit in the proxy instead of reaching the agent.
	reverse_proxy api:3001 {
		flush_interval -1
	}
}
